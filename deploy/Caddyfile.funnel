{
    servers {
        trusted_proxies static {$FUNNEL_TRUSTED_PROXY_CIDRS:127.0.0.1/32}
        trusted_proxies_strict
    }
}
:80 {
    encode gzip zstd
    handle /api/* {
        reverse_proxy auth-api:8000 {
            header_up X-Forwarded-For {client_ip}
            header_up -X-Real-IP
        }
    }
    handle /health {
        reverse_proxy auth-api:8000
    }
    handle {
        root * /srv/www
        try_files {path} /index.html
        file_server
    }
}
