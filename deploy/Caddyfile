{
	servers {
		# Funnel entra por el gateway de la red Docker dedicada.
		trusted_proxies static 172.30.253.1/32
		trusted_proxies_strict
	}
}

:80 {
	encode gzip zstd

	# API FastAPI (red interna de Compose)
	handle /api/* {
		reverse_proxy backend:8000 {
			# Enviar solo la IP verificada de la cadena de proxies.
			header_up X-Forwarded-For {client_ip}
			header_up -X-Real-IP
		}
	}

	# Healthcheck accesible vía proxy
	handle /health {
		reverse_proxy backend:8000
	}

	# Assets con hash en el nombre: caché larga
	@hashedAssets path_regexp hashed \.[0-9a-f]{8,}\.(js|css|woff2?)$
	handle @hashedAssets {
		root * /srv/www
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# SPA Angular: fallback a index.html para rutas del cliente
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
