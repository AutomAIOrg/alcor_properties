#!/usr/bin/env bash
set -eu

ROOT_DIR="$(git rev-parse --show-toplevel)"

export LANG=C.utf8
export LC_ALL=C.utf8

if [ -d "$ROOT_DIR/backend/.venv" ]; then
  . "$ROOT_DIR/backend/.venv/bin/activate"
elif [ -d "$ROOT_DIR/.venv" ]; then
  . "$ROOT_DIR/.venv/bin/activate"
else
  echo "Missing Python virtualenv. Create one and install local dev dependencies before committing."
  echo "Expected: python3.13 -m venv .venv && . .venv/bin/activate && pip install pre-commit"
  exit 1
fi

python -m pre_commit --version >/dev/null 2>&1 || {
  echo "pre-commit is not installed. Install it before committing."
  exit 1
}

cd "$ROOT_DIR"
python -m pre_commit run
